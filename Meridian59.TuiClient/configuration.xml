<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <resources
    version="10016"
    path="Resources"
    preloadrooms="false"
    preloadobjects="false"
    preloadroomtextures="false"
    preloadsound="false"
    preloadmusic="false" />

  <connections selectedindex="0">
    <connection
      name="localhost"
      host="900.emfiftynine.info"
      port="5959"
      useipv6="false"
      stringdictionary="rsc0000-900.rsb"
      username=""
      password=""
      character="">
      <ignorelist />
    </connection>
  </connections>
  
  <connection
    majorversion="90"
    minorversion="90"
    logfile="bot.log"
    debug="true" />

  <admins>
  </admins>

  <!-- Server-side player preferences sent on login.
       safetyoff:   PvP safety off
       tempsafe:    Receive temporary angel on death
       grouping:    Join building/defense groups automatically
       autoloot:    Auto-pick up loot from kills
       autocombine: Auto-combine spell reagent items
       reagentbag:  Auto-move reagents to reagent bag
       spellpower:  Show spell power readout on cast
  -->
  <preferences
    safetyoff="false"
    tempsafe="true"
    grouping="false"
    autoloot="true"
    autocombine="true"
    reagentbag="false"
    spellpower="false" />

  <keymap>
    <bind key="UpArrow" action="MoveUp" />
    <bind key="DownArrow" action="MoveDown" />
    <bind key="LeftArrow" action="MoveLeft" />
    <bind key="RightArrow" action="MoveRight" />
    <bind key="W" action="MoveUp" />
    <bind key="S" action="MoveDown" />
    <bind key="A" action="MoveLeft" />
    <bind key="D" action="MoveRight" />
     <bind key="Spacebar" action="ManualGo" />
    <bind key="Q" action="TargetSelf" />
    <!-- Quit via /quit command or Ctrl+Q -->
    <bind key="Add" action="ZoomIn" />
    <bind key="OemPlus" action="ZoomIn" />
    <bind key="Subtract" action="ZoomOut" />
    <bind key="OemMinus" action="ZoomOut" />
    <bind key="PageUp" action="ScrollUp" />
    <bind key="PageDown" action="ScrollDown" />
    <bind key="Enter" action="EnterChat" />
     <bind key="G" action="Get" />
    <!-- Example hotkeys -->
    <bind key="D1" action="Hotkey1" />
    <bind key="D2" action="Hotkey2" />
    <bind key="M" action="Mail" />
  </keymap>
</configuration>
